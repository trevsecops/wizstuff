# Copy to .env (gitignored) OR export these in your shell. Never commit the real values.
# Service account type: Custom Integration (GraphQL API). Scopes: read:controls, read:issues,
# optional read:cloud_configuration_rule.
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
# Optional: derived from the token's dc claim if unset. Copy from Wiz console -> user menu -> Tenant Info -> API Endpoint URL
WIZ_API_URL=https://api.usXX.app.wiz.io/graphql
# Optional (defaults shown)
# WIZ_AUTH_URL=https://auth.app.wiz.io/oauth/token
# WIZ_AUDIENCE=wiz-api
# WIZ_APP_URL=https://app.wiz.io
